# Keep local/private runtime and infrastructure data out of build contexts.
**/__pycache__
**/*.pyc
**/dist-test
**/.terraform
**/*.tfstate*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/backend.hcl

# Git ignore rules do not apply to Docker build contexts.
**/.env
**/.env.*
**/*.env
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.dump
**/*.dump.gz
**/*.log
**/.aws
**/.ssh
**/.venv
**/cookies*.json*
cookie-auth/runtime
collector-runtime
.references
private-imports
local-audit
