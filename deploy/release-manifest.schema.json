{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rogi.chat/schemas/release-manifest-v1.json",
  "title": "Rogi Collector release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "profile",
    "sourceSha",
    "releaseId",
    "contractVersion",
    "composeSha256",
    "runtimeFiles",
    "images",
    "migrations",
    "runtimeNonSecret"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "rogi-collector"
    },
    "profile": {
      "const": "soop-single-channel"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,96}$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "composeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtimeFiles": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(deploy|tools/ops)/[A-Za-z0-9._/@-]+$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres",
        "redis",
        "discover",
        "coordinator",
        "worker",
        "query",
        "cookie-auth"
      ],
      "properties": {
        "postgres": {
          "$ref": "#/$defs/image"
        },
        "redis": {
          "$ref": "#/$defs/image"
        },
        "discover": {
          "$ref": "#/$defs/image"
        },
        "coordinator": {
          "$ref": "#/$defs/image"
        },
        "worker": {
          "$ref": "#/$defs/image"
        },
        "query": {
          "$ref": "#/$defs/image"
        },
        "cookie-auth": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^deploy/migrations/[A-Za-z0-9._-]+\\.sql$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "runtimeNonSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composeProjectName",
        "dataRoot",
        "secretsRoot",
        "releaseRoot",
        "postgresDatabase",
        "postgresAdminUser",
        "postgresMigrateUser",
        "capabilities",
        "queryBindIp"
      ],
      "properties": {
        "composeProjectName": {
          "const": "rogi-collector"
        },
        "dataRoot": {
          "const": "/srv/rogi-collector"
        },
        "secretsRoot": {
          "const": "/run/rogi-collector"
        },
        "releaseRoot": {
          "const": "/opt/rogi-collector/app/current"
        },
        "postgresDatabase": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "postgresAdminUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "postgresMigrateUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grpc7443"
          ],
          "properties": {
            "grpc7443": {
              "const": "mtls-collector-v1"
            }
          }
        },
        "queryBindIp": {
          "type": "string",
          "pattern": "^10\\.(?:\\d{1,3}\\.){2}\\d{1,3}$"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*(?::[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"
    }
  }
}
